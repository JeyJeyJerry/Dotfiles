{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
        "1": "#d79921",
        "2": "#d65d0e",
    },
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "#d65d0e",
      "title": "#fe8019"
    }
  },
  "percent": {
    "type": 9,
    "color": {
      "green": "green",
      "yellow": "light_yellow",
      "red": "light_red"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "monitor",
    "de",
    "theme",
    "icons",
    "terminal",
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true
    },
    {
      "type": "gpu",
      "driverSpecific": true,
      "temp": true
    },
    "memory",
    "disk",
    "datetime",
    {
      "type": "weather",
      "timeout": 1000
    },
    "break",
    "colors"
  ]
}
