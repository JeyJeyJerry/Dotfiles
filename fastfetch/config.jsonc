// ---------- Core ----------

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "type": "small",
        "padding": {
            "top": 1,
            "left": 3
        },
        "color": {
            "1": "#d65d0e",
            "2": "#fe8019"
        }
    },
    "display": {
        "separator": " ",
        "percent": {
            "type": 3
        },
        "key": {
            "width": 12
        }
    },

// ---------- Modules ----------

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#d65d0e",
                "at": "#ebdbb2",
                "host": "#d65d0e"
            }
        },
        "separator",
        {
            "type": "kernel",
            "key": "Distro",
            "keyColor": "#cc241d"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#98971a"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#d79921"
        },
        {
            "type": "memory",
            "key": "RAM",
            "keyColor": "#458588"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "#b16286",
            "folders": [
                "/"
            ]
        },
        {
            "type": "packages",
            "key": "Packages",
            "format": "{pacman} (pacman)",
            "keyColor": "#689d6a"
        },
        {
            "type": "battery",
            "key": "   Battery  ",
            "keyColor": "#ebdbb2"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
