{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch",
        "color": {
            "1": "yellow",
            "2": "light_yellow"
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "yellow",
            "title": "light_yellow"
        },
        "key": {
            "type": "string"
        },
        "bar": {
            "width": 10,
            "char": {
                "elapsed": "■",
                "total": "-"
            }
        },
        "percent": {
            "type": 2,
            "color": {
                "green": "green",
                "yellow": "light_yellow",
                "red": "light_red"
            }
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        {
            "type": "display",
            "format": "{width}x{height} @ {refresh-rate} Hz ({inch}\")"
        },
        "de",
        "wm",
        {
            "type": "theme",
            "format": "{theme1}"
        },
        {
            "type": "icons",
            "format": "{icons1}"
        },
        "terminal",
        {
            "type": "terminalfont",
            "format": "{name}"
        },
        {
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "type": "gpu",
            "format": "{name} - {temperature}",
            "driverSpecific": false,
            "temp": true,
            "hideType": "integrated"
        },
        "memory",
        "disk"
    ]
}
